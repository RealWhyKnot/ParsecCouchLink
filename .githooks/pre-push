#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n ${repo_root} ]] || exit 0
cd "${repo_root}"

if ! command -v pwsh >/dev/null 2>&1; then
  echo "pre-push: pwsh was not found; install PowerShell 7, then run .github/lint/lint.ps1." >&2
  exit 1
fi
pwsh -NoProfile -File .github/lint/lint.ps1
