#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n ${repo_root} ]] || exit 0
cd "${repo_root}"

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/lint.ps1
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File tools/lint.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File tools/lint.ps1
else
  echo "pre-push: PowerShell was not found; run tools/lint.ps1 before pushing." >&2
  exit 1
fi
